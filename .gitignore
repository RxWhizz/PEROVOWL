.venv/
.venv_*/
.venv-win/
__pycache__/
*.pyc
.ipynb_checkpoints/

# outputs pesados DFT/ML
*.npy
*.npz
*.traj
*.cube
*.gpw
*.log
*.out
*.png
*.jpg
*.pdf
!docs/screenshots/
!docs/screenshots/*.png
*.hdf5
*.h5
*.pkl

# BUHO pipeline — datos generados (regenerables desde el generador)
# (sin comentarios inline: en .gitignore '#' solo inicia comentario al principio de línea)
runs/
data/raw/
data/processed/
data/batches/
reports/mpi_benchmark.json

# CSVs generados; conservar datos curados de literatura
*.csv
!data/meff_lit.csv
!data/dielectric_lit.csv
!data/surrogate_training.csv

# JSONL pesados generados
*.jsonl

configs/monitor.local.yaml
configs/monitor.yaml

# Frontend del monitor web
frontend/node_modules/
frontend/dist/
src/monitor_api/static/

# Auditoría del monitor
logs/
src/monitor_api/openapi.json

# Artefactos de empaquetado
build/
dist/
*.spec.bak
.build-ram-state

# Enlaces al volumen externo.
#
# Una regla con barra final NO casa con un symlink: `build/` ignora el
# directorio build pero deja pasar un enlace llamado `build`. Aquí todos estos
# son enlaces a /media/..., así que necesitan la forma anclada y sin barra.
# Sin esto, un `git add -A` comitea seis enlaces rotos para cualquier otro
# checkout.
/.venv
/build
/dist
/data
/logs
/reports
/runs
/local_runs
/calculations

# Assets descargados o generados para publicar releases; no van al historial.
/releases/

# Entornos y cachés de prueba
.pytest_cache/
.tmp_pytest/

# App de escritorio (Flutter)
apps/dft_monitor_flutter/build/
apps/dft_monitor_flutter/.dart_tool/
apps/dft_monitor_flutter/.flutter-plugins*
apps/dft_monitor_flutter/test/_alpha.cif

# Copias de seguridad de configuración
configs/*.bak-*
configs/*.save
openapitools.json

# Secretos: el .env nunca se comitea. La plantilla .env.example sí.
.env
.env.*
!.env.example

# Configuración de asistentes y de IDE: no pertenece al repositorio.
.claude/
.codex
.codex/
.cursor/
.aider*
.idea/
.vscode/

# Documentacion en Markdown: fuera del repositorio salvo los README, que son
# la puerta de entrada y si tienen que viajar con el codigo.
#
# Ojo: .gitignore solo afecta a lo NO rastreado. Los .md que ya estan en el
# indice siguen versionandose hasta que se saquen con `git rm --cached`.
*.md
!README.md
# Las notas de cada release salen de aqui: tiene que viajar con el codigo.
!docs/notas-release.md

# Logs que GPAW escribe en el directorio de trabajo al calibrar. Son salida de
# diagnostico de un calculo concreto, no artefactos del proyecto.
eg_scale_*.txt
conv_*.txt
bootstrap_*.txt
gllb_probe.txt
